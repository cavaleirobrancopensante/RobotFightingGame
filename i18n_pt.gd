	"Claw Arm": "Braço Garra",
	"Coil Frame": "Chassi Bobina",
	"Command Mast": "Mastro de Comando",
	"Counter Protocol": "Protocolo Contra-ataque",
	"Cowboy hat": "Chapéu de cowboy",

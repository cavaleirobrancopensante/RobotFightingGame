	"Evasion": "Evasión",
	"Every move on its own key: special-move inputs get +0.3s.": "Cada golpe en su tecla: los comandos de golpe especial ganan +0,3s.",
	"Executor Arm": "Brazo Ejecutor",
	"Explodes for %d damage when it's destroyed.": "Explota causando %d de daño al ser destruido.",
	"Eye Laser": "Láser Ocular",
	"Eye patch": "Parche",
	"FEBRUARY": "FEBRERO",
